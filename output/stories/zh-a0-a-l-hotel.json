    {
      "sequence_order": 14,
      "text_target": "这里有椅子。",
      "phonetic": "Zhè lǐ yǒu yǐzi.",
      "text_native": "Il y a une chaise ici."
    },
    {
      "sequence_order": 15,
      "text_target": "我坐椅子。",
      "phonetic": "Wǒ zuò yǐzi.",
      "text_native": "Je m'assieds sur la chaise."
    },
    {
      "sequence_order": 16,
