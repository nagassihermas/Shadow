    {
      "sequence_order": 3,
      "text_target": "我看前台。",
      "phonetic": "Wǒ kàn qiántái.",
      "text_native": "Je vois la réception."
    },
    {
      "sequence_order": 4,
      "text_target": "我要房间。",
      "phonetic": "Wǒ yào fángjiān.",
      "text_native": "Je veux une chambre."
    },
    {
      "sequence_order": 5,
