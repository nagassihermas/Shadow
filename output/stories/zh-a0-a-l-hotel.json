      "phonetic": "Wǒ yǒu bēizi.",
      "text_native": "J'ai un verre."
    },
    {
      "sequence_order": 17,
      "text_target": "我喝水。",
      "phonetic": "Wǒ hē shuǐ.",
      "text_native": "Je bois de l'eau."
