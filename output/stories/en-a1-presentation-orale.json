    {
      "sequence_order": 24,
      "text_target": "My voice is clear.",
      "phonetic": "/maɪ vɔɪs ɪz klɪr/",
      "text_native": "Ma voix est claire."
    },
    {
      "sequence_order": 25,
      "text_target": "People understand.",
      "phonetic": "/ˈpiːpəl ˌʌndərˈstænd/",
      "text_native": "Les gens comprennent."
    },
    {
      "sequence_order": 26,
      "text_target": "I answer a question.",
      "phonetic": "/aɪ ˈænsər ə ˈkwɛstʃən/",
      "text_native": "Je réponds à une question."
    },
    {
      "sequence_order": 27,
      "text_target": "It is time to finish.",
      "phonetic": "/ɪt ɪz taɪm tuː ˈfɪnɪʃ/",
