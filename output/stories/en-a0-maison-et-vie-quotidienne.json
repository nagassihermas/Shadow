    },
    {
      "sequence_order": 3,
      "text_target": "I am in my room.",
      "phonetic": "/aɪ æm ɪn maɪ ruːm/",
      "text_native": "Je suis dans ma chambre."
    },
    {
      "sequence_order": 4,
      "text_target": "The bed is big.",
      "phonetic": "/ðə bɛd ɪz bɪɡ/",
      "text_native": "Le lit est grand."
    },
    {
      "sequence_order": 5,
      "text_target": "I get up now.",
