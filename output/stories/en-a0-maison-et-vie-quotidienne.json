    {
      "sequence_order": 19,
      "text_target": "I clean the table.",
      "phonetic": "/aɪ kliːn ðə ˈteɪ.bəl/",
      "text_native": "Je nettoie la table."
    },
    {
      "sequence_order": 20,
      "text_target": "I put my plate down.",
      "phonetic": "/aɪ pʊt maɪ pleɪt daʊn/",
      "text_native": "Je pose mon assiette."
    },
    {
      "sequence_order": 21,
      "text_target": "I walk back to my room.",
      "phonetic": "/aɪ wɔːk bæk tuː maɪ ruːm/",
      "text_native": "Je retourne dans ma chambre."
