    {
      "sequence_order": 22,
      "text_target": "I put on my clothes.",
      "phonetic": "/aɪ pʊt ɒn maɪ kloʊðz/",
      "text_native": "Je mets mes vêtements."
    },
    {
      "sequence_order": 23,
      "text_target": "I grab my blue bag.",
      "phonetic": "/aɪ ɡræb maɪ bluː bæɡ/",
      "text_native": "Je prends mon sac bleu."
    },
    {
      "sequence_order": 24,
      "text_target": "My phone is inside.",
      "phonetic": "/maɪ foʊn ɪz ɪnˈsaɪd/",
      "text_native": "Mon téléphone est à l'intérieur."
    },
    {
      "sequence_order": 25,
      "text_target": "I look for my keys.",
      "phonetic": "/aɪ lʊk fɔːr maɪ kiːz/",
      "text_native": "Je cherche mes clés."
    },
    {
      "sequence_order": 26,
      "text_target": "Here is the key.",
      "phonetic": "/hɪər ɪz ðə kiː/",
      "text_native": "Voici la clé."
    },
    {
      "sequence_order": 27,
      "text_target": "I lock the front door.",
      "phonetic": "/aɪ lɒk ðə frʌnt dɔːr/",
      "text_native": "Je ferme la porte d'entrée à clé."
    },
    {
      "sequence_order": 28,
      "text_target": "I leave my house.",
      "phonetic": "/aɪ liːv maɪ haʊs/",
      "text_native": "Je quitte ma maison."
    },
    {
      "sequence_order": 29,
      "text_target": "I walk to work.",
      "phonetic": "/aɪ wɔːk tuː wɜːrk/",
      "text_native": "Je vais au travail à pied."
    },
    {
      "sequence_order": 30,
      "text_target": "My day starts now.",
      "phonetic": "/maɪ deɪ stɑːrts naʊ/",
      "text_native": "Ma journée commence maintenant."
    }
