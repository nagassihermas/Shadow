      "text_native": "C'est le matin."
    },
    {
      "sequence_order": 10,
      "text_target": "I go to the kitchen.",
      "phonetic": "/aɪ ɡoʊ tuː ðə ˈkɪtʃ.ən/",
      "text_native": "Je vais à la cuisine."
    },
    {
      "sequence_order": 11,
      "text_target": "The table is white.",
      "phonetic": "/ðə ˈteɪ.bəl ɪz waɪt/",
      "text_native": "La table est blanche."
    },
    {
      "sequence_order": 12,
      "text_target": "I sit on a chair.",
