    },
    {
      "sequence_order": 6,
      "text_target": "I walk to the bathroom.",
      "phonetic": "/aɪ wɔːk tuː ðə ˈbæθ.ruːm/",
      "text_native": "Je marche vers la salle de bains."
    },
    {
