      "text_native": "Je m'assois sur une chaise."
    },
    {
      "sequence_order": 13,
      "text_target": "I want some food.",
      "phonetic": "/aɪ wɒnt sʌm fuːd/",
      "text_native": "Je veux un peu de nourriture."
    },
    {
      "sequence_order": 14,
      "text_target": "I have a cup.",
      "phonetic": "/aɪ hæv ə kʌp/",
      "text_native": "J'ai une tasse."
    },
    {
      "sequence_order": 15,
      "text_target": "I pour some milk.",
      "phonetic": "/aɪ pɔːr sʌm mɪlk/",
      "text_native": "Je verse un peu de lait."
    },
    {
      "sequence_order": 16,
      "text_target": "I drink cold water.",
      "phonetic": "/aɪ drɪŋk koʊld ˈwɔː.tər/",
      "text_native": "Je bois de l'eau froide."
    },
    {
      "sequence_order": 17,
      "text_target": "The bread is good.",
      "phonetic": "/ðə brɛd ɪz ɡʊd/",
      "text_native": "Le pain est bon."
    },
    {
      "sequence_order": 18,
      "text_target": "I eat breakfast.",
      "phonetic": "/aɪ iːt ˈbrɛk.fəst/",
      "text_native": "Je prends le petit-déjeuner."
