  "sentences": [
    {
      "sequence_order": 1,
      "text_target": "我今天很饿。",
      "phonetic": "Wǒ jīntiān hěn è.",
      "text_native": "J'ai très faim aujourd'hui."
    },
    {
      "sequence_order": 2,
      "text_target": "我去一个饭馆。",
