      "text_native": "Je vais dans un restaurant."
    },
    {
      "sequence_order": 3,
      "text_target": "服务员你好。",
      "phonetic": "Fúwùyuán, nǐ hǎo.",
      "text_native": "Bonjour, serveur."
    },
    {
      "sequence_order": 4,
      "text_target": "我一个人。",
      "phonetic": "Wǒ yī gè rén.",
      "text_native": "Je suis tout seul."
    },
    {
      "sequence_order": 5,
      "text_target": "请问能坐吗？",
      "phonetic": "Qǐngwèn néng zuò ma?",
      "text_native": "Puis-je m'asseoir, s'il vous plaît ?"
    },
    {
      "sequence_order": 6,
      "text_target": "可以，请坐那张桌子。",
      "phonetic": "Kěyǐ, qǐng zuò nà zhāng zhuōzi.",
      "text_native": "Oui, veuillez vous asseoir à cette table."
