      "text_target": "He clicks on reply.",
      "phonetic": "/hiː klɪks ɒn rɪˈplaɪ/",
      "text_native": "Il clique sur répondre."
    },
    {
      "sequence_order": 13,
      "text_target": "He puts his hands on the keyboard.",
