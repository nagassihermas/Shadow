      "text_native": "Il est à son bureau."
    },
    {
      "sequence_order": 3,
      "text_target": "He has a computer.",
      "phonetic": "/hiː hæz ə kəmˈpjuːtə/",
      "text_native": "Il a un ordinateur."
    },
    {
      "sequence_order": 4,
      "text_target": "The computer is on.",
      "phonetic": "/ðə kəmˈpjuːtə ɪz ɒn/",
      "text_native": "L'ordinateur est allumé."
