      "text_native": "Tom entre dans le bureau."
    },
    {
      "sequence_order": 2,
      "text_target": "He opens the door.",
      "phonetic": "/hi ˈəʊpənz ðə dɔː/",
      "text_native": "Il ouvre la porte."
    },
    {
      "sequence_order": 3,
      "text_target": "He sits on his chair.",
      "phonetic": "/hi sɪts ɒn hɪz ʧeə/",
      "text_native": "Il s'assoit sur sa chaise."
    },
    {
      "sequence_order": 4,
      "text_target": "His computer is on the desk.",
      "phonetic": "/hɪz kəmˈpjuːtər ɪz ɒn ðə dɛsk/",
      "text_native": "Son ordinateur est sur le bureau."
    },
    {
      "sequence_order": 5,
      "text_target": "He looks at the screen.",
