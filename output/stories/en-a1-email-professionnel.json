    {
      "sequence_order": 12,
      "text_target": "His boss sends the text.",
      "phonetic": "/hɪz bɒs sɛndz ðə tɛkst/",
      "text_native": "Son patron envoie le message."
    },
    {
      "sequence_order": 13,
      "text_target": "Tom reads the document.",
      "phonetic": "/tɒm riːdz ðə ˈdɒkjʊmənt/",
      "text_native": "Tom lit le document."
    },
    {
      "sequence_order": 14,
      "text_target": "\"Good morning\" is at the top.",
      "phonetic": "/gʊd ˈmɔːnɪŋ ɪz æt ðə tɒp/",
      "text_native": "« Bonjour » est en haut."
    },
    {
      "sequence_order": 15,
      "text_target": "He checks the work details.",
      "phonetic": "/hi ʧɛks ðə wɜːk ˈdiːteɪlz/",
      "text_native": "Il vérifie les détails du travail."
    },
    {
      "sequence_order": 16,
      "text_target": "The time is important.",
      "phonetic": "/ðə taɪm ɪz ɪmˈpɔːtənt/",
      "text_native": "L'heure est importante."
    },
    {
      "sequence_order": 17,
      "text_target": "Tom needs to reply.",
      "phonetic": "/tɒm niːdz tu rɪˈplaɪ/",
      "text_native": "Tom doit répondre."
    },
    {
      "sequence_order": 18,
      "text_target": "He writes a new reply.",
      "phonetic": "/hi raɪts ə njuː rɪˈplaɪ/",
      "text_native": "Il écrit une nouvelle réponse."
    },
    {
      "sequence_order": 19,
      "text_target": "He types his name.",
      "phonetic": "/hi taɪps hɪz neɪm/",
      "text_native": "Il tape son nom."
    },
    {
      "sequence_order": 20,
      "text_target": "He says thank you.",
      "phonetic": "/hi sɛz θæŋk juː/",
      "text_native": "Il dit merci."
    },
    {
      "sequence_order": 21,
      "text_target": "He adds please in the note.",
      "phonetic": "/hi ædz pliːz ɪn ðə nəʊt/",
      "text_native": "Il ajoute s'il vous plaît dans le message."
    },
    {
      "sequence_order": 22,
      "text_target": "He looks at the email again.",
      "phonetic": "/hi lʊks æt ðə ˈiːmeɪl əˈgɛn/",
      "text_native": "Il relit l'e-mail."
    },
    {
      "sequence_order": 23,
      "text_target": "Everything is good.",
      "phonetic": "/ˈɛvriθɪŋ ɪz gʊd/",
      "text_native": "Tout est bon."
    },
    {
      "sequence_order": 24,
      "text_target": "He sends the message now.",
      "phonetic": "/hi sɛndz ðə ˈmɛsɪʤ naʊ/",
      "text_native": "Il envoie le message maintenant."
    },
    {
      "sequence_order": 25,
      "text_target": "He saves the document.",
      "phonetic": "/hi seɪvz ðə ˈdɒkjʊmənt/",
      "text_native": "Il enregistre le document."
    },
    {
      "sequence_order": 26,
      "text_target": "He closes the application.",
      "phonetic": "/hi ˈkləʊzɪz ði ˌæplɪˈkeɪʃən/",
      "text_native": "Il ferme l'application."
    },
    {
      "sequence_order": 27,
      "text_target": "He turns off the computer.",
      "phonetic": "/hi tɜːnz ɒf ðə kəmˈpjuːtə/",
      "text_native": "Il éteint l'ordinateur."
    },
    {
      "sequence_order": 28,
      "text_target": "Tom stands up from his chair.",
      "phonetic": "/tɒm stændz ʌp frɒm hɪz ʧeə/",
      "text_native": "Tom se lève de sa chaise."
    },
    {
      "sequence_order": 29,
      "text_target": "It is the end of the day.",
      "phonetic": "/ɪt ɪz ði ɛnd ɒv ðə deɪ/",
      "text_native": "C'est la fin de la journée."
    },
    {
      "sequence_order": 30,
