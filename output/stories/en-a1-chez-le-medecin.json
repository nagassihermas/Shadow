      "text_native": "Le médecin est prêt."
    },
    {
      "sequence_order": 12,
      "text_target": "He is a good doctor.",
      "phonetic": "/hiː ɪz ə gʊd ˈdɒktər/",
      "text_native": "C'est un bon médecin."
    },
    {
      "sequence_order": 13,
      "text_target": "Tom sits on a chair.",
      "phonetic": "/tɒm sɪts ɒn ə tʃɛər/",
      "text_native": "Tom s'assoit sur une chaise."
    },
    {
      "sequence_order": 14,
      "text_target": "He looks at the patient.",
      "phonetic": "/hiː lʊks æt ðə ˈpeɪʃənt/",
      "text_native": "Il regarde le patient."
    },
    {
      "sequence_order": 15,
      "text_target": "He asks about the problem.",
