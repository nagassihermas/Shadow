    {
      "sequence_order": 8,
      "text_target": "The door is open.",
      "phonetic": "/ðə dɔːr ɪz ˈoʊpən/",
      "text_native": "La porte est ouverte."
    },
    {
      "sequence_order": 9,
      "text_target": "Tom enters the room.",
      "phonetic": "/tɒm ˈɛntərz ðə ruːm/",
      "text_native": "Tom entre dans la pièce."
    },
    {
      "sequence_order": 10,
      "text_target": "He says hello.",
      "phonetic": "/hiː sɛz həˈloʊ/",
