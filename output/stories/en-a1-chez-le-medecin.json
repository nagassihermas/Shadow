    },
    {
      "sequence_order": 17,
      "text_target": "My head hurts.",
      "phonetic": "/maɪ hɛd hɜːrts/",
      "text_native": "Ma tête me fait mal."
    },
    {
      "sequence_order": 18,
      "text_target": "My throat hurts too.",
      "phonetic": "/maɪ θroʊt hɜːrts tuː/",
      "text_native": "Ma gorge me fait mal aussi."
    },
    {
      "sequence_order": 19,
      "text_target": "I have a bad cough.",
      "phonetic": "/aɪ hæv ə bæd kɒf/",
      "text_native": "J'ai une mauvaise toux."
    },
    {
      "sequence_order": 20,
      "text_target": "The doctor listens well.",
      "phonetic": "/ðə ˈdɒktər ˈlɪsənz wɛl/",
      "text_native": "Le médecin écoute attentivement."
    },
    {
      "sequence_order": 21,
      "text_target": "Please open your mouth.",
      "phonetic": "/pliːz ˈoʊpən jʊər maʊθ/",
      "text_native": "Veuillez ouvrir la bouche."
    },
    {
      "sequence_order": 22,
      "text_target": "Tom says ah.",
      "phonetic": "/tɒm sɛz ɑː/",
      "text_native": "Tom dit ah."
    },
    {
      "sequence_order": 23,
      "text_target": "The doctor writes on paper.",
      "phonetic": "/ðə ˈdɒktər raɪts ɒn ˈpeɪpər/",
      "text_native": "Le médecin écrit sur du papier."
    },
    {
      "sequence_order": 24,
      "text_target": "It is a prescription.",
      "phonetic": "/ɪt ɪz ə prɪˈskrɪpʃən/",
      "text_native": "C'est une ordonnance."
    },
    {
      "sequence_order": 25,
      "text_target": "Tom needs medicine.",
      "phonetic": "/tɒm niːdz ˈmɛdɪsɪn/",
      "text_native": "Tom a besoin de médicaments."
    },
    {
      "sequence_order": 26,
      "text_target": "He takes the paper.",
      "phonetic": "/hiː teɪks ðə ˈpeɪpər/",
      "text_native": "Il prend le papier."
    },
    {
      "sequence_order": 27,
      "text_target": "He goes to the pharmacy.",
      "phonetic": "/hiː goʊz tuː ðə ˈfɑːrməsi/",
      "text_native": "Il va à la pharmacie."
    },
    {
      "sequence_order": 28,
      "text_target": "He buys the medicine.",
      "phonetic": "/hiː baɪz ðə ˈmɛdɪsɪn/",
      "text_native": "Il achète le médicament."
    },
    {
      "sequence_order": 29,
      "text_target": "Tom takes a rest.",
      "phonetic": "/tɒm teɪks ə rɛst/",
      "text_native": "Tom se repose."
    },
    {
      "sequence_order": 30,
      "text_target": "He is well in two days.",
      "phonetic": "/hiː ɪz wɛl ɪn tuː deɪz/",
      "text_native": "Il va bien en deux jours."
