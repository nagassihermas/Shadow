  "sentences": [
    {
      "sequence_order": 1,
      "text_target": "It is a bad morning.",
      "phonetic": "/ɪt ɪz ə bæd ˈmɔːrnɪŋ/",
      "text_native": "C'est un mauvais matin."
    },
    {
      "sequence_order": 2,
      "text_target": "Tom is very sick.",
      "phonetic": "/tɒm ɪz ˈvɛri sɪk/",
      "text_native": "Tom est très malade."
    },
    {
      "sequence_order": 3,
      "text_target": "He has a headache.",
      "phonetic": "/hiː hæz ə ˈhɛd.eɪk/",
      "text_native": "Il a mal à la tête."
    },
    {
      "sequence_order": 4,
      "text_target": "He has a fever too.",
      "phonetic": "/hiː hæz ə ˈfiːvər tuː/",
      "text_native": "Il a de la fièvre aussi."
    },
    {
      "sequence_order": 5,
      "text_target": "His stomach hurts.",
