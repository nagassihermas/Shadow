      "text_native": "Il n'a pas d'appétit."
    },
    {
      "sequence_order": 19,
      "text_target": "His body is very weak.",
      "phonetic": "/hɪz ˈbɑːdi ɪz ˈvɛri wiːk/",
      "text_native": "Son corps est très faible."
    },
    {
      "sequence_order": 20,
      "text_target": "His temperature is high.",
      "phonetic": "/hɪz ˈtɛmprətʃər ɪz haɪ/",
      "text_native": "Sa température est élevée."
