      "text_native": "Il vérifie le thermomètre."
    },
    {
      "sequence_order": 22,
      "text_target": "Tom looks for medicine.",
      "phonetic": "/tɒm lʊks fɔːr ˈmɛdɪsɪn/",
      "text_native": "Tom cherche des médicaments."
    },
    {
      "sequence_order": 23,
      "text_target": "He takes some pills.",
      "phonetic": "/hi teɪks sʌm pɪlz/",
      "text_native": "Il prend des cachets."
    },
    {
      "sequence_order": 24,
      "text_target": "He takes his phone.",
      "phonetic": "/hi teɪks hɪz foʊn/",
      "text_native": "Il prend son téléphone."
    },
    {
      "sequence_order": 25,
      "text_target": "He calls his boss now.",
      "phonetic": "/hi kɔːlz hɪz bɔːs naʊ/",
      "text_native": "Il appelle son patron."
    },
    {
      "sequence_order": 26,
      "text_target": "He calls the doctor too.",
      "phonetic": "/hi kɔːlz ðə ˈdɑːktər tuː/",
      "text_native": "Il appelle aussi le médecin."
    },
    {
      "sequence_order": 27,
      "text_target": "He says he cannot work.",
      "phonetic": "/hi sɛz hi ˈkænɒt wɜːrk/",
      "text_native": "Il dit qu'il ne peut pas travailler."
    },
    {
      "sequence_order": 28,
      "text_target": "He goes back to bed.",
      "phonetic": "/hi ɡoʊz bæk tu bɛd/",
      "text_native": "Il retourne se coucher."
    },
    {
      "sequence_order": 29,
      "text_target": "He closes his eyes.",
      "phonetic": "/hi ˈkloʊzɪz hɪz aɪz/",
      "text_native": "Il ferme les yeux."
    },
    {
      "sequence_order": 30,
      "text_target": "He rests all day long.",
