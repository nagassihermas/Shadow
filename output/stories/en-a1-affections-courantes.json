  "sentences": [
    {
      "sequence_order": 1,
      "text_target": "It is Monday morning.",
      "phonetic": "/ɪt ɪz ˈmʌndeɪ ˈmɔːrnɪŋ/",
      "text_native": "C'est lundi matin."
    },
    {
      "sequence_order": 2,
      "text_target": "Tom wakes up early.",
      "phonetic": "/tɒm weɪks ʌp ˈɜːrli/",
      "text_native": "Tom se réveille tôt."
    },
    {
      "sequence_order": 3,
      "text_target": "He does not feel good.",
      "phonetic": "/hi dʌz nɒt fiːl ɡʊd/",
      "text_native": "Il ne se sent pas bien."
    },
    {
      "sequence_order": 4,
      "text_target": "He has a headache.",
      "phonetic": "/hi hæz ə ˈhɛd.eɪk/",
      "text_native": "Il a mal à la tête."
    },
    {
      "sequence_order": 5,
      "text_target": "His throat hurts.",
      "phonetic": "/hɪz θroʊt hɜːrts/",
      "text_native": "Il a mal à la gorge."
    },
    {
      "sequence_order": 6,
      "text_target": "He has a bad cold.",
      "phonetic": "/hi hæz ə bæd koʊld/",
      "text_native": "Il a un gros rhume."
    },
    {
      "sequence_order": 7,
      "text_target": "He also has a fever.",
