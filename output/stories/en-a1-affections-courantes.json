    },
    {
      "sequence_order": 8,
      "text_target": "Tom feels very tired.",
      "phonetic": "/tɒm fiːlz ˈvɛri ˈtaɪərd/",
      "text_native": "Tom se sent très fatigué."
    },
    {
      "sequence_order": 9,
      "text_target": "He starts to cough.",
      "phonetic": "/hi stɑːrts tu kɔːf/",
      "text_native": "Il commence à tousser."
    },
    {
      "sequence_order": 10,
      "text_target": "He walks to the kitchen.",
      "phonetic": "/hi wɔːks tu ðə ˈkɪtʃən/",
      "text_native": "Il marche vers la cuisine."
