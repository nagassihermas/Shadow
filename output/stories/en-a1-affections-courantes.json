    {
      "sequence_order": 11,
      "text_target": "He walks very slowly.",
      "phonetic": "/hi wɔːks ˈvɛri ˈsloʊli/",
      "text_native": "Il marche très lentement."
    },
    {
      "sequence_order": 12,
      "text_target": "He wants some water.",
      "phonetic": "/hi wɒnts sʌm ˈwɔːtər/",
      "text_native": "Il veut un peu d'eau."
    },
    {
      "sequence_order": 13,
      "text_target": "He drinks a big glass.",
      "phonetic": "/hi drɪŋks ə bɪɡ ɡlæs/",
      "text_native": "Il en boit un grand verre."
    },
    {
      "sequence_order": 14,
      "text_target": "He sits on a chair.",
      "phonetic": "/hi sɪts ɒn ə tʃɛər/",
      "text_native": "Il s'assoit sur une chaise."
    },
    {
      "sequence_order": 15,
      "text_target": "He looks at the table.",
      "phonetic": "/hi lʊks æt ðə ˈteɪbəl/",
      "text_native": "Il regarde la table."
    },
    {
      "sequence_order": 16,
      "text_target": "He wants to eat bread.",
      "phonetic": "/hi wɒnts tu iːt brɛd/",
      "text_native": "Il veut manger du pain."
    },
    {
      "sequence_order": 17,
      "text_target": "He eats nothing today.",
      "phonetic": "/hi iːts ˈnʌθɪŋ təˈdeɪ/",
      "text_native": "Il ne mange rien aujourd'hui."
    },
    {
      "sequence_order": 18,
      "text_target": "He has no appetite.",
